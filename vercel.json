{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    { "src": "index.html",           "use": "@vercel/static" },
    { "src": "verifier-email.html",  "use": "@vercel/static" },
    { "src": "reinitialiser.html",   "use": "@vercel/static" },
    { "src": "api.js",               "use": "@vercel/static" },
    { "src": "script.js",            "use": "@vercel/static" },
    { "src": "styles.css",           "use": "@vercel/static" },
    { "src": "robots.txt",           "use": "@vercel/static" },
    { "src": "sitemap.xml",          "use": "@vercel/static" },
    { "src": "assets/**",            "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=604800" },
      "continue": true
    },
    {
      "src": "/(script|api)\\.js",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "/styles\\.css",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
      "dest": "/index.html"
    }
  ]
}
