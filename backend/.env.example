# Copiez ce fichier en "backend/.env".
#
# En développement, la configuration par défaut fonctionne sans rien
# modifier : SQLite en fichier local, e-mails écrits dans la console.
#
# En production (Vercel, Render, VPS...), ces variables se déclarent
# dans le tableau de bord de l'hébergeur et NON dans un fichier .env :
# voir DEPLOIEMENT.md.

# ─── Clé de signature ─────────────────────────────────────────────────
# Sert à signer le cookie d'état OAuth LinkedIn.
# OBLIGATOIRE en production, et elle doit rester stable : sur un
# hébergement serverless, chaque instance repartirait sinon avec une clé
# différente et la connexion LinkedIn échouerait au retour.
# Générez-la avec :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez-par-une-chaine-aleatoire-longue

# ─── Environnement ────────────────────────────────────────────────────
# developpement (défaut en local) | production
# Détecté automatiquement sur Vercel.
ENVIRONNEMENT=developpement

# ─── Base de données ──────────────────────────────────────────────────
# sqlite   (défaut) -> fichier local lasource.db, aucune installation
# postgres          -> serveur PostgreSQL. OBLIGATOIRE sur un hébergement
#                      sans disque persistant (Vercel, Render, Railway) :
#                      un fichier SQLite y serait effacé à chaque
#                      redémarrage, avec toutes les données.
# mysql             -> serveur MySQL classique
DB_TYPE=sqlite

# Chemin du fichier SQLite (DB_TYPE=sqlite uniquement)
# DB_PATH=/chemin/absolu/vers/lasource.db

# PostgreSQL : une seule variable suffit. Neon, Supabase, Vercel Postgres,
# Render et Railway la fournissent telle quelle après création de la base.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/lasource

# Connexion détaillée — alternative à DATABASE_URL, et seule option pour
# MySQL. Le port par défaut suit DB_TYPE (5432 ou 3306).
DB_HOST=localhost
# DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=lasource

# Création automatique du schéma au premier démarrage (1 = oui).
# Mettez 0 si vous préférez appliquer database/schema_postgres.sql à la main.
INIT_DB_AUTO=1

# ─── Sessions et cookies ──────────────────────────────────────────────
DUREE_SESSION_JOURS=14

# Drapeau Secure du cookie de session.
# auto (défaut) = posé dès que la connexion est en HTTPS. Ne forcez une
# valeur que si votre infrastructure est atypique.
# COOKIE_SECURE=auto

# ─── Limitation du débit ──────────────────────────────────────────────
# Les tentatives sont comptées en base, donc la limitation résiste à un
# hébergement sans état où les instances vont et viennent.
#
# Inscriptions tolérées par adresse IP et par quart d'heure. La valeur
# par défaut laisse passer une salle de classe entière derrière une seule
# adresse publique — cas courant sur un campus ou un réseau mobile —
# tout en arrêtant un robot, qui en tenterait des milliers.
# MAX_INSCRIPTIONS_PAR_IP=30

# Demandes de réinitialisation tolérées par adresse e-mail et par IP,
# sur le même quart d'heure. Empêche d'inonder la boîte d'un tiers.
# MAX_DEMANDES_MDP=3

# Nombre de reverse proxys de confiance devant l'application.
# 0 en local, 1 derrière Vercel / Render / Nginx. Sans cette valeur,
# tous les visiteurs partageraient le même compteur anti-force-brute.
# Détecté automatiquement en production.
# NB_PROXYS=1

# ─── Vérification d'adresse e-mail ────────────────────────────────────
# Exiger la confirmation empêche de créer un compte avec l'adresse de
# quelqu'un d'autre.
#
# Par défaut, elle s'active d'elle-même là où le message peut réellement
# partir : ENVIRONNEMENT=production ET EMAIL_MODE=smtp. L'imposer sans
# SMTP rendrait l'inscription impossible, personne ne recevant le lien.
#
# 1 = obligatoire, 0 = facultative. Renseignez-la pour trancher
#     explicitement, laissez-la commentée pour la déduction automatique.
# VERIFICATION_EMAIL_OBLIGATOIRE=1

# ─── Envoi des e-mails ────────────────────────────────────────────────
# console = le message est écrit dans les logs du serveur (dev)
# smtp    = envoi réel (obligatoire en production)
EMAIL_MODE=console

# Adresse publique du site, utilisée dans les liens des e-mails.
# En développement, laissez la valeur locale.
# En production sur lasourcee.org, renseignez :
#   URL_PLATEFORME=https://lasourcee.org
# Cela garantit que les liens de confirmation et de réinitialisation
# pointent toujours vers le domaine définitif, même si le site est
# aussi joignable via l'adresse .vercel.app.
URL_PLATEFORME=http://localhost:5000

# Paramètres SMTP (requis uniquement si EMAIL_MODE=smtp)
#
# Avec Gmail :
#   1. Activez la validation en 2 étapes sur le compte Google.
#   2. Compte Google → Sécurité → Mots de passe d'application.
#   3. Créez un mot de passe pour « Autre (LaSourcee) » et collez les
#      16 caractères dans SMTP_MOTDEPASSE (le mot de passe habituel
#      du compte est refusé par Google).
#
# Autres fournisseurs courants :
#   Outlook  : smtp.office365.com   port 587  starttls
#   OVH      : ssl0.ovh.net         port 587  starttls
#   SendGrid : smtp.sendgrid.net    port 587  starttls (utilisateur = apikey)
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_EXPEDITEUR=LaSourcee <votre.adresse@gmail.com>
SMTP_SECURITE=starttls

# ─── OAuth Google (optionnel) ─────────────────────────────────────────
# Procédure :
#   1. Allez sur https://console.cloud.google.com/
#   2. Créez un projet, puis « API et services » → « Identifiants ».
#   3. Créer des identifiants → ID client OAuth 2.0
#      Type d'application : Application Web
#      Origines JavaScript autorisées :
#         http://localhost:5000    (développement)
#         https://lasourcee.org    (production)
#      URI de redirection : aucune (Google Identity Services)
#   4. Copiez le Client ID ci-dessous.
GOOGLE_CLIENT_ID=

# ─── OAuth LinkedIn (optionnel) ───────────────────────────────────────
# Procédure :
#   1. Allez sur https://www.linkedin.com/developers/apps
#   2. Créez une "App", activez "Sign In with LinkedIn using OpenID Connect"
#   3. Dans "Auth" → URLs de redirection OAuth 2.0 autorisées :
#      http://localhost:5000/api/auth/linkedin/callback  (développement)
#      https://lasourcee.org/api/auth/linkedin/callback  (production)
#   4. Copiez Client ID et Client Secret ci-dessous.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/auth/linkedin/callback
